{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DKB Downloader",
  "version": "1.2.6",
  "identifier": "com.dangkhoabach.dkb-downloader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "DKB Downloader",
        "width": 1080,
        "height": 720,
        "minWidth": 760,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/yt-dlp", "binaries/ffmpeg"]
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://updates.dangkhoabach.vn/dkb-downloader/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYwMEIyNTQ4NEFFQjFBQzkKUldUSkd1dEtTQ1VMWU5GVElqQzRLYUpXc3ordnhqQ3d3dlRXcGJJb3J2bEMwYlFXbnlrV1VnemIK"
    }
  }
}
