# Xcode / Swift Package Manager — only project.pbxproj is tracked
build/
.build/
DerivedData/
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
*.xcuserstate
xcuserdata/

# yt-dlp/ffmpeg sidecar seed binaries — fetched via scripts/fetch-sidecars.sh,
# not committed since they're large and change with every release.
vendor/binaries/

# Editor directories and files
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Signing secrets for release builds — never commit
.env.release

# scripts/release.sh's downloaded Sparkle CLI tools + local build output —
# both reproducible, neither should be committed.
.sparkle-tools/
release-output/
